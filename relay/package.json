{
  "name": "formfillai-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FormFillAI の任意の中継サーバー。アプリが組み立てた問い合わせを Vercel AI Gateway 経由で typesafe-ai/jev に渡す。",
  "engines": {
    "node": ">=20.6"
